{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-creator.local/candidates/v0.11/lifecycle-checkpoint-v1.json",
  "title": "Lifecycle Checkpoint Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "candidate_version",
    "parent_version",
    "release_state",
    "transition_rule_ref",
    "immutable_boundary",
    "validation_profile",
    "blockers",
    "next_legal_action",
    "required_artifacts",
    "stop_condition"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-candidate"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^LCP-[A-Za-z0-9._-]+$"
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "parent_version": {
      "type": "string",
      "minLength": 1
    },
    "release_state": {
      "enum": [
        "UNFROZEN_DISCOVERY",
        "PREREGISTRATION_DRAFT",
        "PREFREEZE_REVIEW",
        "FROZEN",
        "IMPLEMENTING",
        "VERIFYING",
        "PROMOTED_EXPERIMENTAL",
        "RETRY_REQUIRED",
        "REJECTED",
        "PAUSED"
      ]
    },
    "immutable_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "historical_versions",
        "hash_algorithm",
        "mutation_rule"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "historical_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "mutation_rule": {
          "type": "string",
          "minLength": 1
        },
        "registry_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "commands",
        "success_condition"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "status",
          "description",
          "transition_token"
        ],
        "properties": {
          "blocker_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "WAIVED_BY_GOVERNOR"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner_decision_required": {
            "type": "boolean"
          },
          "transition_token": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_legal_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_token",
        "description",
        "allowed_actor",
        "required_inputs",
        "expected_outputs"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actor": {
          "type": "string",
          "minLength": 1
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transition_rule_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
