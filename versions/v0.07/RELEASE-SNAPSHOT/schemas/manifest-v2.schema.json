{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-creator.local/schemas/manifest-v2.json",
  "title": "Version Manifest v2",
  "type": "object",
  "required": [
    "manifest_schema_version",
    "version",
    "parent_version",
    "status",
    "protocol_schema_version",
    "added_capabilities",
    "removed_or_deprecated_capabilities",
    "breaking_changes",
    "required_migrations",
    "new_regressions",
    "retired_regressions",
    "preregistered_goals",
    "evaluation_result",
    "promotion_decision",
    "release_contract_hash",
    "content_hashes",
    "rollback_ref"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "2.0"
    },
    "version": {
      "type": "string"
    },
    "parent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "experimental",
        "promoted_experimental",
        "promoted",
        "rejected",
        "blocked"
      ]
    },
    "protocol_schema_version": {
      "type": "string"
    },
    "added_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_or_deprecated_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REG-[A-Za-z0-9._-]+$"
      }
    },
    "retired_regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REG-[A-Za-z0-9._-]+$"
      }
    },
    "preregistered_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluation_result": {
      "type": "string"
    },
    "promotion_decision": {
      "enum": [
        "PROMOTED",
        "PROMOTED AS EXPERIMENTAL",
        "RETRY REQUIRED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "release_contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
