{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-creator.local/schemas/improvement-v1.json",
  "title": "Improvement Proposal v1",
  "type": "object",
  "required": [
    "improvement_id",
    "origin_version",
    "target_version",
    "observed_problem",
    "evidence_refs",
    "hypothesis",
    "proposed_change",
    "preregistered_acceptance",
    "risk_level",
    "status"
  ],
  "properties": {
    "improvement_id": {
      "type": "string"
    },
    "origin_version": {
      "type": "string"
    },
    "target_version": {
      "type": "string"
    },
    "observed_problem": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "hypothesis": {
      "type": "string"
    },
    "proposed_change": {
      "type": "string"
    },
    "expected_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preregistered_acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "observed",
        "diagnosed",
        "proposed",
        "preregistered",
        "implementing",
        "evaluating",
        "adopted",
        "rejected",
        "deferred",
        "superseded"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ]
    },
    "regression_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}