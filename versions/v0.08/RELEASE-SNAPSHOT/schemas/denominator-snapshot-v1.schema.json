{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-creator.local/schemas/denominator-snapshot-v1.json",
  "title": "Metric Denominator Snapshot v1",
  "type": "object",
  "required": [
    "snapshot_id",
    "metric_name",
    "cutoff_utc",
    "scope",
    "denominator_value",
    "denominator_unit",
    "source_event_ids",
    "missing_data"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^DEN-[A-Za-z0-9._-]+$"
    },
    "metric_name": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "denominator_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "denominator_unit": {
      "type": "string",
      "minLength": 1
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "missing_data": {
      "type": "object",
      "required": [
        "status",
        "details"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "unavailable"
          ]
        },
        "details": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
