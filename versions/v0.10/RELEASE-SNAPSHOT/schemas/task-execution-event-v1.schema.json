{
  "$id": "https://spec-creator.local/schemas/task-execution-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_id": {
      "pattern": "^TEVT-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "event_time_utc": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "from_state": {
      "enum": [
        null,
        "planned",
        "ready",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "pattern": "^CTASK-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "to_state": {
      "enum": [
        "planned",
        "ready",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ]
    }
  },
  "required": [
    "event_id",
    "graph_hash",
    "task_id",
    "event_time_utc",
    "actor_id",
    "from_state",
    "to_state",
    "evidence_refs"
  ],
  "title": "Task Execution Event v1",
  "type": "object"
}
