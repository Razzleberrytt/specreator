{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-creator.local/schemas/experiment-v1.json",
  "title": "Spec Creator Improvement Experiment v1",
  "type": "object",
  "required": [
    "experiment_id",
    "hypothesis",
    "comparison_unit",
    "parent_version",
    "candidate_version",
    "project_corpus",
    "controlled_variables",
    "primary_metric",
    "guardrail_metrics",
    "minimum_acceptable_improvement",
    "failure_criteria",
    "missing_data_policy",
    "evaluator_method",
    "freeze_timestamp"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Za-z0-9._-]+$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "comparison_unit": {
      "type": "string",
      "minLength": 1
    },
    "parent_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "project_corpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controlled_variables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "guardrail_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "minimum_acceptable_improvement": {
      "type": "string",
      "minLength": 1
    },
    "failure_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_data_policy": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_method": {
      "type": "string",
      "minLength": 1
    },
    "freeze_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
